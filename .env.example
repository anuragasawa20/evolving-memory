# --- Database (Docker Compose local dev) ---
# Host port is 5433 to avoid clashing with a locally-installed PostgreSQL on 5432.
DATABASE_URL=postgresql://dealos:dealos_dev_password@127.0.0.1:5433/dealos

# --- OpenRouter / NVIDIA Nemotron ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Walrus Memory Mainnet ---
# Ed25519 delegate key (NOT the wallet owner key). Hex or suiprivkey1...
MEMWAL_PRIVATE_KEY=
# Walrus Memory account object ID on Sui
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=dealos_demo_deals
MEMWAL_ORGANIZATION_NAMESPACE=dealos_demo_organization
MEMWAL_LEARNING_NAMESPACE=dealos_demo_learning

# --- Tatum Sui Mainnet RPC ---
# Get a key at https://dashboard.tatum.io
TATUM_API_KEY=
TATUM_SUI_RPC_URL=https://sui-mainnet.gateway.tatum.io

# --- Demo organization (optional) ---
# Used by /intelligence and /learning to scope synthetic multi-rep data.
DEFAULT_ORGANIZATION_SLUG=dealos-demo
DEFAULT_ORGANIZATION_NAME=DealOS Demo Organization
DEFAULT_SALES_REP=Alex Morgan
